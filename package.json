{
  "name": "nutri-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --env-file=.env.local db/migrate.mjs && node --env-file=.env.local scripts/catalog/sync.mjs",
    "db:migrate:prod": "TURSO_DATABASE_URL=$(turso db show nutri-app --url) TURSO_AUTH_TOKEN=$(turso db tokens create nutri-app --expiration 1d) sh -c \"node db/migrate.mjs && node scripts/catalog/sync.mjs\""
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
